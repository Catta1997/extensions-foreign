{
  "name": "nmn-extension-foreign-0.8",
  "repositoryName": "NmN's Foreign Extensions (0.8)",
  "version": "2.0.0",
  "description": "Repo for non-english manga sources. (0.8)",
  "main": "index.js",
  "scripts": {
    "bundle": "gulp bundle --gulpfile node_modules/paperback-extensions-common/src/repo-gulpfile.js",
    "serve": "npx paperback serve",
    "debug": "npx paperback logcat --ip=192.168.29.226",
    "test": "node_modules/.bin/mocha --timeout 300000 -r ts-node/register src/**/*.test.ts",
    "start": "tsc && node dist/api.js",
    "build": "tsc",
    "coverage": "nyc -r lcov -e .ts -x \"*.test.ts\" npm run test"
  },
  "author": "NmN",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.1",
    "@types/cheerio": "^0.22.35",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^7.27.0",
    "eslint-plugin-modules-newline": "^0.0.6",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@paperback/toolchain": "0.8.0-alpha.47",
    "@paperback/types": "0.8.0-alpha.47",
    "@types/crypto-js": "^4.1.1",
    "chai": "^5.2.0",
    "chai-as-promised": "^8.0.1",
    "cheerio": "^1.0.0",
    "crypto-js": "^4.1.1",
    "entities": "^4.4.0",
    "nodemon": "^2.0.22",
    "paperback-extensions-common": "^5.0.0-alpha.7",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.2.1",
    "tsify": "^5.0.4"
  }
}
